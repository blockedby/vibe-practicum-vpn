# Secrets / generated client configs
*.key
*.conf
*.conf.*
*.qr.png
secrets/
clients/

# Runtime dumps that may contain sensitive data
*.pcap
*.dump

# Local Go build artifact from `go build -o vibe-vpn ./cmd/vibe-vpn`
/vibe-vpn

# Hermes/Pi orchestration artifacts (local prompts, logs, sessions)
/.hermes/

# Local git worktrees used by Hermes/Pi agents
/.worktrees/

# Keep sanitized examples/docs tracked explicitly if needed
!examples/*.conf
