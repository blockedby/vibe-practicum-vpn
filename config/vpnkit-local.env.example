# Public-safe local vpnkit asset-rendering inputs.
# Keep the generated PKI, inline profile, rendered server config, and any
# subscription URL under the gitignored secrets/vpnkit-local/ tree.
VPNKIT_LOCAL_SECRETS_DIR=secrets/vpnkit-local
VPNKIT_LOCAL_ENDPOINT=127.0.0.1
VPNKIT_LOCAL_OPENVPN_PORT=21194
VPNKIT_LOCAL_OPENVPN_PUSH_DNS=8.8.8.8
VPNKIT_LOCAL_COMPOSE_PROJECT=vpnkit-local
VPNKIT_LOCAL_DOCKER_SUBNET=172.30.89.0/24
VPNKIT_LOCAL_CONTAINER_ADDRESS=172.30.89.2
VPNKIT_LOCAL_POLICY=strict
VPNKIT_BOOTSTRAP_PICK_ON_START=true
VPNKIT_BOOTSTRAP_MAX_NODES=50
# First selection can take roughly candidate_count * timeout_seconds.
VPNKIT_LOCAL_BOOT_TIMEOUT_SECONDS=1200
# One-button TUI start/stop manages only the `vpnkit-local` NM connection.
# Set false for container-only diagnostics before the one-time host helper install.
VPNKIT_LOCAL_MANAGE_NETWORKMANAGER=true
