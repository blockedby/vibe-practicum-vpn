    }
  ],
  "outbounds": [
    {{SELECTED_NATIVE_OUT_JSON}},
    { "type": "direct", "tag": "direct-out" },
    { "type": "block", "tag": "block-out" }
  ],
  "route": {
    "rules": [
      { "protocol": "dns", "outbound": "selected-native-out" }
    ],
    "final": "selected-native-out"
  }
}
