{
  "log": { "level": "debug", "timestamp": true },
  "dns": {
    "servers": [
      { "tag": "remote-dns", "address": "tls://1.1.1.1", "detour": "selected-native-out" }
    ],
    "final": "remote-dns"
  },
  "inbounds": [
    {
      "type": "tproxy",
