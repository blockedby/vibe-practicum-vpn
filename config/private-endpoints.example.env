# Example private endpoint inventory for local operators.
# Copy to config/private-endpoints.local.env and fill with real private values.
# Never commit the .local.env file.

VPNKIT_VPS_SSH_HOST=your-vps-ssh-alias
VPNKIT_VPS_PUBLIC_ENDPOINT=203.0.113.10
VPNKIT_STEAMDECK_SSH_HOST=your-steamdeck-ssh-alias
VPNKIT_STEAMDECK_LAN_ENDPOINT=192.0.2.10
VPNKIT_PRODUCTION_OPENVPN_ENDPOINT=vpn.example.invalid
VPNKIT_EXTRA_NODE_NAME=example-extra-node
VPNKIT_EXTRA_NODE_HOST=203.0.113.20
VPNKIT_EXTRA_NODE_SNI=example-private-node.invalid
# Tailnet/private listener placeholders. Copy real values to the gitignored local env file.
VPNKIT_VPS_TAILNET_IP=192.0.2.10
SING_BOX_SOCKS_ADDR=192.0.2.10:2080
OPENVPN_ASUS_LAN_CIDR=192.0.2.0/24

# Vercel DNS failover placeholders. Keep real values in config/private-endpoints.local.env only.
VPN_FAILOVER_ENDPOINTS="vibe-practicum moscow-tiger"
VPN_FAILOVER_DOMAIN=vpn.example.invalid
VPN_DNS_RECORD_NAME=vpn
VPN_DNS_EXPECTED_CURRENT=203.0.113.10
VPN_DNS_FAILED_OVER_EXPECTED_CURRENT=203.0.113.20
VPN_DNS_ROLLBACK_TARGET=203.0.113.10
VPN_DNS_TTL=60
VIBE_PRACTICUM_PUBLIC_ENDPOINT=203.0.113.10
VIBE_PRACTICUM_HEALTH=healthy
VIBE_PRACTICUM_LATENCY_MS=120
MOSCOW_TIGER_PUBLIC_ENDPOINT=203.0.113.20
MOSCOW_TIGER_HEALTH=healthy
MOSCOW_TIGER_LATENCY_MS=90
VERCEL_TOKEN=vercel-token-placeholder
# Optional test/read-only discovery hooks; do not commit real command output.
# MOCK_VERCEL_CURRENT=203.0.113.10
# VERCEL_DNS_CURRENT_CMD='vercel dns ls "$VPN_FAILOVER_DOMAIN" --token "$VERCEL_TOKEN" ...'
