# Example private endpoint inventory for local operators.
# Copy to config/private-endpoints.local.env and fill with real private values.
# Never commit the .local.env file.

VPNKIT_VPS_SSH_HOST=your-vps-ssh-alias
VPNKIT_VPS_PUBLIC_ENDPOINT=203.0.113.10
VPNKIT_STEAMDECK_SSH_HOST=your-steamdeck-ssh-alias
VPNKIT_STEAMDECK_LAN_ENDPOINT=192.0.2.10
VPNKIT_EXTRA_NODE_NAME=example-extra-node
VPNKIT_EXTRA_NODE_HOST=203.0.113.20
VPNKIT_EXTRA_NODE_SNI=example-private-node.invalid
# Tailnet/private listener placeholders. Copy real values to the gitignored local env file.
VPNKIT_VPS_TAILNET_IP=192.0.2.10
SING_BOX_SOCKS_ADDR=192.0.2.10:2080
OPENVPN_ASUS_LAN_CIDR=192.0.2.0/24
