{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vpnkit public manifest",
  "type": "object",
  "required": ["version", "capabilities", "servers", "clients", "pairs"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "const": 1},
    "capabilities": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"}, "uniqueItems": true},
    "servers": {"type": "object", "additionalProperties": {"$ref": "#/$defs/server"}, "minProperties": 1},
    "clients": {"type": "object", "additionalProperties": {"$ref": "#/$defs/client"}, "minProperties": 1},
    "pairs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/pair"}, "minProperties": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "bindingRef": {"type": "string", "pattern": "^local:[A-Z0-9_]+$"},
    "server": {
      "type": "object", "required": ["displayName", "capabilities", "profile_inputs", "config_inputs"], "additionalProperties": false,
      "properties": {
        "displayName": {"type": "string"},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "profile_inputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/bindingRef"}},
        "config_inputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/bindingRef"}}
      }
    },
    "client": {
      "type": "object", "required": ["id", "displayName", "profileCommonName", "clientCertIdentity", "capabilities", "profile_inputs"], "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "displayName": {"type": "string"},
        "profileCommonName": {"type": "string"},
        "clientCertIdentity": {"type": "string"},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "profile_inputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/bindingRef"}}
      }
    },
    "pair": {
      "type": "object", "required": ["server", "client", "requires_capabilities", "profile"], "additionalProperties": false,
      "properties": {
        "server": {"$ref": "#/$defs/id"},
        "client": {"$ref": "#/$defs/id"},
        "requires_capabilities": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "profile": {
          "type": "object", "required": ["mode", "remote", "port", "proto", "required_bindings"], "additionalProperties": false,
          "properties": {
            "mode": {"type": "string", "enum": ["openvpn"]},
            "remote": {"$ref": "#/$defs/bindingRef"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "proto": {"type": "string", "enum": ["udp", "tcp"]},
            "required_bindings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        }
      }
    }
  }
}
