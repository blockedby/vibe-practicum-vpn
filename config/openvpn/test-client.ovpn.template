client
dev tun
proto udp
remote vpnkit 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth SHA256
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305:AES-256-CBC
data-ciphers-fallback AES-256-CBC
cipher AES-256-GCM
key-direction 1
verb 3
<ca>
{{CA_CRT}}
</ca>
<cert>
{{CLIENT_CRT}}
</cert>
<key>
{{CLIENT_KEY}}
</key>
<tls-auth>
{{TA_KEY}}
</tls-auth>
