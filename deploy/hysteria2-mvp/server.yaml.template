# Hysteria 2 MVP server config template.
# Rendered by install-vps.sh into /opt/vibe-hy2-mvp/server.yaml.
# All client traffic is forced through the existing sing-box SOCKS listener
# using the socks5 outbound below; there is intentionally no direct outbound
# and no external resolver configured here.

listen: :{{HY2_LISTEN_PORT}}

tls:
  cert: /etc/hysteria/server.crt
  key: /etc/hysteria/server.key
  # The MVP uses a self-signed certificate with client-side pinSHA256.
  sniGuard: disable

auth:
  type: password
  password: "{{HY2_AUTH_PASSWORD}}"

obfs:
  type: salamander
  salamander:
    password: "{{HY2_OBFS_PASSWORD}}"

ignoreClientBandwidth: true
congestion:
  type: bbr
  bbrProfile: standard

# Hysteria supports SOCKS5 outbounds for TCP and UDP. The first outbound is
# also the default, and the ACL rule makes the intended path explicit.
outbounds:
  - name: sing_box_socks
    type: socks5
    socks5:
      addr: "{{SING_BOX_SOCKS_ADDR}}"

acl:
  inline:
    - sing_box_socks(all)

masquerade:
  type: string
  string:
    content: ok
    statusCode: 200
