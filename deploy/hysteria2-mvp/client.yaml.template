# Hysteria 2 local sandbox client template.
# Render with ./run-client-podman.sh --env-file ./server.env --render-only
# or run the Podman sandbox directly with ./run-client-podman.sh --env-file ./server.env
#
# This client exposes proxies only inside the container. The script publishes them
# on host loopback as 127.0.0.1:1080 (SOCKS5) and 127.0.0.1:8081 (HTTP).

server: {{HY2_SERVER}}
auth: {{HY2_AUTH_PASSWORD}}

tls:
  # MVP server uses a self-signed cert, so insecure must be true, but pinSHA256
  # still pins the expected certificate fingerprint.
  insecure: {{HY2_TLS_INSECURE}}
  pinSHA256: {{HY2_PIN_SHA256}}
  sni: {{HY2_SNI}}

obfs:
  type: salamander
  salamander:
    password: {{HY2_OBFS_PASSWORD}}

congestion:
  type: bbr
  bbrProfile: standard

socks5:
  listen: 0.0.0.0:1080

http:
  listen: 0.0.0.0:8081
