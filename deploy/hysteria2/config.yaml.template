# Hysteria2 server config template.
#
# This file is public-safe and intentionally contains only placeholders. The
# compose service renders an equivalent runtime config from variables in the
# gitignored `.env` file so rendered secrets do not need to live in the repo.
# If you render this template manually, write the result to a gitignored local
# file and do not commit passwords, endpoint values, certs, or runtime state.

listen: :${HY2_HOST_UDP_PORT}

tls:
  # Default live approach for this repo: reuse Caddy's existing certificate.
  # Caddy serves TCP/80 and TCP/443, while Hysteria2 serves UDP/443. Caddy
  # HTTP/3/QUIC must stay disabled so it does not bind UDP/443.
  cert: "${HY2_TLS_CERT}"
  key: "${HY2_TLS_KEY}"
  sniGuard: strict

# Per-client credentials. Keep real values in gitignored `.env` only.
auth:
  type: userpass
  userpass:
    "${HY2_AUTH_MOSCOW_TIGER_USER}": "${HY2_AUTH_MOSCOW_TIGER_PASSWORD}"
    "${HY2_AUTH_VIBE_PRACTICUM_USER}": "${HY2_AUTH_VIBE_PRACTICUM_PASSWORD}"
    "${HY2_AUTH_PERSONAL_USER}": "${HY2_AUTH_PERSONAL_PASSWORD}"

obfs:
  # Salamander obfuscation is enabled by default; clients need the same password.
  type: salamander
  salamander:
    password: "${HY2_OBFS_PASSWORD}"

masquerade:
  type: proxy
  proxy:
    url: "${HY2_MASQUERADE_URL}"
    rewriteHost: true
