# Copy to .env on the deployment host and edit locally. Do not commit .env.
# Values below are placeholders/examples only.

# Runtime image and names. The default container name is intentionally distinct
# from existing vpnkit/OpenVPN containers.
HY2_IMAGE=tobyxdd/hysteria:v2
HY2_CONTAINER_NAME=hysteria2-udp443

# Publish only host UDP/443 to container UDP/443. Keep TCP/443 available for
# Caddy. Caddy HTTP/3/QUIC must be disabled so it does not bind UDP/443.
HY2_HOST_UDP_PORT=443

# Public DNS name used by clients and TLS SNI. Use a real domain only in your
# gitignored local .env.
HY2_SERVER_NAME=hy2.example.invalid

# Default live approach: reuse Caddy's existing Let's Encrypt cert/key. The host
# path is mounted read-only at /caddy-certs inside the Hysteria2 container.
HY2_CADDY_CERTS_DIR=/var/lib/caddy/.local/share/caddy/certificates
HY2_TLS_CERT=/caddy-certs/acme-v02.api.letsencrypt.org-directory/hy2.example.invalid/hy2.example.invalid.crt
HY2_TLS_KEY=/caddy-certs/acme-v02.api.letsencrypt.org-directory/hy2.example.invalid/hy2.example.invalid.key

# Per-client auth. Replace with long random values in local .env.
HY2_AUTH_MOSCOW_TIGER_USER=moscow-tiger
HY2_AUTH_MOSCOW_TIGER_PASSWORD=replace-with-long-random-moscow-tiger-password
HY2_AUTH_VIBE_PRACTICUM_USER=vibe-practicum
HY2_AUTH_VIBE_PRACTICUM_PASSWORD=replace-with-long-random-vibe-practicum-password
HY2_AUTH_PERSONAL_USER=personal
HY2_AUTH_PERSONAL_PASSWORD=replace-with-long-random-personal-password

# Shared obfuscation password. Clients need the same value.
HY2_OBFS_PASSWORD=replace-with-long-random-obfs-password

# Optional camouflage target for Hysteria2 masquerade proxy mode.
HY2_MASQUERADE_URL=https://www.example.com/

# Local persistent state for Hysteria2 runtime data. This directory is ignored.
HY2_DATA_DIR=./data
