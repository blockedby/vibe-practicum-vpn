# Copy to .env on the Steam Deck and edit locally. Do not commit .env.

# Operator-provided OpenVPN client profile on the Deck. The default path is
# gitignored by this repo. Put the real .ovpn there or set another local path.
VPNKIT_DECK_CLIENT_PROFILE=./local/client.ovpn

# Runtime names intentionally do not touch the existing vpnkit server container.
VPNKIT_DECK_CLIENT_CONTAINER=vpnkit-host-ovpn-client
VPNKIT_DECK_CLIENT_IMAGE=localhost/vpnkit-host-ovpn-client:latest
VPNKIT_DECK_LOG_DIR=./logs

# If rootless Podman cannot create host tun0 on your Deck, use rootful Podman.
# SteamOS has a small /var, so prefer rootful storage under /home when building
# a dedicated image:
# VPNKIT_DECK_PODMAN="sudo podman --root /home/deck/.local/share/vpnkit-root-podman --runroot /run/vpnkit-root-podman"
VPNKIT_DECK_PODMAN=podman

# Host tunnel interface expected after OpenVPN starts.
VPNKIT_DECK_VPN_IFACE=tun0
