# Steam Deck singnox hotspot client local settings.
# Copy to .env, fill with local-only values, and never commit .env.

# SSH target used by repo-level Deck helper scripts. Use a local SSH alias or host.
SINGNOX_SSH_TARGET=deck

# Put one real Hysteria2 client config at one of these gitignored paths:
#   local/hysteria2-client.yaml
#   local/hysteria2-client.uri
# Do not paste the real URI/YAML into this example file.
SINGNOX_HY2_CLIENT_CONFIG=local/hysteria2-client.yaml

# Native sing-box on the Steam Deck. scripts/install-sing-box.sh can copy an
# operator-provided binary to this path.
SINGNOX_SINGBOX_BIN=/home/deck/.local/bin/sing-box
SINGNOX_SINGBOX_MODE=native

# Optional operator-provided local binary/archive for install-sing-box.sh.
# SINGNOX_SINGBOX_SOURCE_BIN=local/sing-box
# SINGNOX_SINGBOX_SOURCE_ARCHIVE=local/sing-box-linux-amd64.tar.gz

# Hotspot settings. The WPA password belongs only in .env or the shell env.
SINGNOX_HOTSPOT_SSID=vpnkit-deck
SINGNOX_HOTSPOT_PASSWORD=
SINGNOX_HOTSPOT_SUBNET=10.42.0.0/24

# Distinct names keep this package separate from any production vpnkit runtime.
SINGNOX_TUN_IFACE=sb-tun0
SINGNOX_TUN_ADDR=172.19.0.1/30
SINGNOX_SINGBOX_UNIT=singnox-hotspot-singbox.service
SINGNOX_SINGBOX_CONTAINER=singnox-hotspot-singbox
SINGNOX_HOTSPOT_CONTAINER=singnox-hotspot-ap
SINGNOX_REMOTE_STATE=/home/deck/.local/state/singnox-hotspot-client

# Package-local generated output. These paths are ignored by git.
SINGNOX_OUTPUT_CONFIG=runtime/sing-box/config.json
SINGNOX_RULE_SET_DIR=runtime/sing-box/rule-sets
SINGNOX_REPORT_DIR=reports
SINGNOX_LOG_DIR=logs
